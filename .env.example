# ==========================================================================
# Cyber Range Platform — 환경변수 예시
# 사용: cp .env.example .env && ./scripts/gen_secrets.sh   (토큰 자동 생성)
# .env 는 절대 커밋하지 마세요(.gitignore 처리됨).
# ==========================================================================

# --- RBAC 역할별 토큰 (설정된 토큰만 해당 역할로 인증) ---------------------
# 토큰/JWT 를 하나도 설정 안 하면 컨트롤플레인은 fail-closed(무인증 요청 401).
# 프로덕션에선 반드시 설정. (gen_secrets.sh 가 INSTRUCTOR_TOKEN 등을 채움)
INSTRUCTOR_TOKEN=
RED_TOKEN=
BLUE_TOKEN=
OBSERVER_TOKEN=

# --- 접근 통제 플래그 ------------------------------------------------------
# 관전자 read 게이트: true면 read 엔드포인트도 인증된 역할 요구(대회 운영 권장).
OBSERVER_READ_ENFORCE=false
# 로컬 개발 편의: 토큰/JWT 를 아무것도 설정하지 않고도 무인증 통과시키려면 true.
# ⚠️ 기본 빈값(=거부). 오직 로컬 dev 에서만 true. 프로덕션/대회에서는 절대 켜지 마세요.
RBAC_ALLOW_INSECURE_DEV=

# --- 챌린지 플래그 시크릿 --------------------------------------------------
# 팀별/매치별 동적 플래그 HMAC 키. 대회마다 새로 생성 권장(gen_secrets.sh가 채움).
AUTH_JWT_SECRET=
AUTH_ADMIN_PASSWORD=
CHALLENGE_SECRET=
# 내부 S2S(ingest) 토큰 — event_collector/score ingest 게이트 + ingest_proxy 주입(감사 3.1/3.2)
SERVICE_TOKEN=

# --- Attack/Defense 핵심 시크릿 -------------------------------------------
ATTACK_DEFENSE_FLAG_SECRET=
ATTACK_DEFENSE_FLAG_HASH_SECRET=
ATTACK_DEFENSE_MANAGEMENT_TOKEN=

# 기본값은 SQLite 개발 모드입니다. 복제 API/engine HA에서만 PostgreSQL URL 설정.
ATTACK_DEFENSE_DATABASE_URL=
ATTACK_DEFENSE_DB_CONNECT_TIMEOUT_SECONDS=5
ATTACK_DEFENSE_DB_STATEMENT_TIMEOUT_MS=10000
ATTACK_DEFENSE_DB_APPLICATION_NAME=cyber-range-attack-defense
ATTACK_DEFENSE_MAX_DB_CLOCK_SKEW_SECONDS=5
KOTH_DEFAULT_LEASE_ROUNDS=2
KOTH_DEFAULT_POINTS_PER_ROUND=3
STEALTH_ALERT_DELAY_ROUNDS=2
STEALTH_DETECTION_WINDOW_ROUNDS=2
STEALTH_ATTACKER_UNDETECTED_POINTS=2
STEALTH_DEFENDER_DETECTION_POINTS=2
MAX_STEALTH_REPORTS_PER_MINUTE=30
# Compose `ad-ha` profile only. URL-safe value required by the generated DSN.
AD_POSTGRES_PASSWORD=

# --- Attack/Defense Kubernetes runtime (선택) -----------------------------
# API에는 cluster-admin/kubeconfig를 넣지 않습니다. trusted host CLI만 사용합니다.
GAME_RUNTIME=docker_compose
KUBERNETES_CONTEXT=
KUBERNETES_KUBECONFIG=
KUBERNETES_KUBECTL=kubectl
KUBERNETES_IMAGE_REGISTRY=registry.local:5000
KUBERNETES_NAMESPACE_PREFIX=ad
KUBERNETES_FIELD_MANAGER=cyber-range-ad-runtime
KUBERNETES_ROLLOUT_TIMEOUT_SECONDS=180
KUBERNETES_POD_SECURITY_VERSION=latest
KUBERNETES_STORAGE_CLASS=
KUBERNETES_STORAGE_SIZE=1Gi
KUBERNETES_PVC_ACCESS_MODE=ReadWriteMany
KUBERNETES_MANAGE_NAMESPACES=true
KUBERNETES_CPU_REQUEST=100m
KUBERNETES_CPU_LIMIT=500m
KUBERNETES_MEMORY_REQUEST=128Mi
KUBERNETES_MEMORY_LIMIT=512Mi

# --- Attack/Defense PCAP 프라이버시 ---------------------------------------
# 실제 경기에서는 두 secret을 서로 다른 고엔트로피 값으로 설정하십시오.
PCAP_RELEASE_DELAY_SECONDS=900
PCAP_MAX_UPLOAD_MB=32
PCAP_MAX_PACKETS=250000
PCAP_MAX_DOWNLOADS_PER_MINUTE=10
PCAP_MAX_FUTURE_SKEW_SECONDS=300
PCAP_ANONYMIZATION_SECRET=
PCAP_WATERMARK_SECRET=

# --- 팀 구성(선택) — 미설정 시 기본 4팀(red_alpha/bravo, blue_alpha/bravo) ---
# PORTAL_TEAMS='[{"team_id":"red_a","name":"레드 A","side":"red"}, ...]'

# --- 공정성/안티치트(P1-5, 선택) — 플래그 제출 rate-limit·lockout ------------
# PORTAL_MAX_ATTEMPTS=10    # 윈도 내 최대 제출(초과 시 429)
# PORTAL_WINDOW_SEC=60      # 슬라이딩 윈도 길이(초)
# PORTAL_LOCK_FAILS=6       # 연속 오답 임계(초과 시 잠금)
# PORTAL_LOCK_SEC=120       # 잠금 지속(초)

# --- TLS(프로덕션 gateway, 선택) — 미설정 시 self-signed 자동 생성 ----------
# TLS_CERT_PATH=/certs/fullchain.pem
# TLS_KEY_PATH=/certs/privkey.pem

# --- 배경 트래픽(감사 §3 G-11, 선택) — 탐지 훈련용 네트워크 계층 양성 노이즈 ---
# traffic_generator가 트윈 양성 엔드포인트로 실 HTTP를 흘려 공격과 동일한 SIEM
# 파이프라인에 노이즈를 실는다(ground truth 라벨→AAR 오탐률 채점). 기본 OFF.
# BACKGROUND_TRAFFIC_ENABLED=true   # 켜면 startup에 자동 기동(또는 POST /control로 제어)
# BACKGROUND_TRAFFIC_EPS=1.0        # 초당 평균 요청 수(업무시간 9~18시 가중, 그 외 0.3배)
